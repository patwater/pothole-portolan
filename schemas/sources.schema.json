{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Source inventory (cities/<slug>/sources.yaml)",
  "type": "array",
  "items": { "$ref": "#/$defs/source" },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source_type", "url", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string" },
        "source_type": {
          "enum": [
            "open_data_portal", "open311", "agency_page", "pavement_report",
            "council_document", "audit", "budget", "statistics_body", "other"
          ]
        },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "status": { "enum": ["listed", "fetched", "unavailable"] },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "archive": {
          "type": "string",
          "pattern": "^sources/[0-9a-f]{64}(\\.[A-Za-z0-9]+)?$"
        },
        "robots_checked": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["fetched", "unavailable"] } }, "required": ["status"] },
          "then": { "required": ["retrieved"] }
        },
        {
          "if": { "properties": { "status": { "const": "fetched" } }, "required": ["status"] },
          "then": {
            "required": ["archive", "robots_checked"],
            "properties": { "robots_checked": { "const": true } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] },
          "then": { "required": ["notes"] }
        }
      ]
    }
  }
}
